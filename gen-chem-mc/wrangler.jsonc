{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gen-chem-mc",
  "main": "backend/worker.ts",
  "compatibility_date": "2026-10-05",

  "ai": {
    "binding": "AI",
    "remote": true
  },
  "env": {
    "images": {
      "name": "neocortex-gemma-images",
      "ai": { "binding": "AI", "remote": true }
    },
    "team": {
      "name": "neocortex-gemma-team",
      "ai": { "binding": "AI", "remote": true }
    }
  }
}
