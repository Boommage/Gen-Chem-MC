{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gen-chem-mc-llama",
  "main": "backend/model.ts",
  "compatibility_date": "2026-10-05",

  "ai": {
    "binding": "AI",
    "remote": true
  },

  "vars": {
    // Change this to try another Workers AI model without editing code.
    "COACH_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast"
  }
}
