# One shared Gemma backend handles text and image messages at the existing text URL.
# Keep your existing .env.local and team token if already configured.
COACH_API_URL=https://neocortex-gemma-team.neocortexmc.workers.dev
COACH_API_TOKEN=

# New teammates: fill in the existing team development token privately.
# LOCAL LIVE OR MOCK: use http://127.0.0.1:8787 and leave the token empty.
# Do not leave duplicate COACH_API_URL or COACH_API_TOKEN lines in the file.
# Never prefix the token with VITE_: that would expose it to the browser.
