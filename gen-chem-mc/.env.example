# Choose ONE mode. Lines beginning with # are comments, not settings.
# LOCAL MODE (mock server or your own Worker):
COACH_API_URL=http://127.0.0.1:8787
COACH_API_TOKEN=

# SHARED LIVE MODE: REPLACE the two lines above with the following values.
# Remove the leading # and use the actual URL/token from the endpoint owner.
# Do not leave duplicate COACH_API_URL or COACH_API_TOKEN lines in the file.
# COACH_API_URL=https://YOUR-TEAM-WORKER.YOUR-SUBDOMAIN.workers.dev
# COACH_API_TOKEN=your-team-development-token
# Never prefix the token with VITE_: that would expose it to the browser.
