# Shared live Coach: no individual Cloudflare login required.
# Copy this file to .env.local, then paste the token from the endpoint owner.
COACH_API_URL=https://neocortex-gemma-team.neocortexmc.workers.dev
COACH_API_TOKEN=

# LOCAL MOCK OR LOCAL WORKER: replace the URL above with http://127.0.0.1:8787
# and leave COACH_API_TOKEN empty. Run dev:mock or dev:api as documented.
# Do not leave duplicate COACH_API_URL or COACH_API_TOKEN lines in the file.
# Never prefix the token with VITE_: that would expose it to the browser.
