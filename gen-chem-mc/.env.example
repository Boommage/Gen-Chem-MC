# Image branch: local Worker or mock until the shared image Worker is deployed.
# Your existing .env.local is not changed automatically when switching branches.
COACH_API_URL=http://127.0.0.1:8787
COACH_API_TOKEN=

# SHARED IMAGES: replace the URL with the actual image Worker origin and add
# its development token. The shared text Worker does not support images.
# Do not leave duplicate COACH_API_URL or COACH_API_TOKEN lines in the file.
# Never prefix the token with VITE_: that would expose it to the browser.
